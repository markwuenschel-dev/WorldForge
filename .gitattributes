# Normalize all text files to LF in the repository (prevents CRLF churn from
# Windows editors touching files on the WSL/Windows shared filesystem).
* text=auto eol=lf

# Explicit text types (authored content / tooling)
*.cpp    text eol=lf
*.h      text eol=lf
*.cs     text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.ini    text eol=lf
Makefile text eol=lf

# Binary asset types (never normalize)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.exr    binary
*.hdr    binary
*.dds    binary
*.psd    binary
*.fbx    binary
*.sbsar  binary
*.zip    binary

# Unreal binary content via Git LFS
Content/** filter=lfs diff=lfs merge=lfs -text
Plugins/**/Content/** filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
