{
  "$id": "https://worldforge.local/specs/scene_survey/scene_survey_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime_executed": {
            "const": true
          }
        },
        "required": [
          "runtime_executed"
        ]
      },
      "then": {
        "properties": {
          "observed_anchor_location": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "observed_anchor_location"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runtime_mode": {
            "enum": [
              "live_survey_runtime"
            ]
          }
        },
        "required": [
          "runtime_mode"
        ]
      },
      "then": {
        "properties": {
          "evidence_paths": {
            "minItems": 1,
            "type": "array"
          },
          "runtime_executed": {
            "const": true
          }
        },
        "required": [
          "runtime_executed",
          "evidence_paths"
        ]
      }
    }
  ],
  "description": "The machine-readable result of a scene survey. Necessary but not sufficient: see x-worldforge-rails for the constraints JSON Schema cannot express.",
  "properties": {
    "acceptance_eligible": {
      "type": "boolean"
    },
    "acceptance_ineligibility_reason": {
      "anyOf": [
        {
          "enum": [
            "independent_subject_anchor_not_observable",
            "observed_world_identity_unverified",
            "observed_actor_identity_unverified",
            "observed_actor_transform_unobserved",
            "survey_not_bound_to_observed_actor"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_bounds_valid": {
      "type": "boolean"
    },
    "camera_capture_ok": {
      "type": "boolean"
    },
    "captures_requested": {
      "items": {
        "enum": [
          "gameplay",
          "elevated_oblique",
          "top_down"
        ]
      },
      "type": "array"
    },
    "cleanup_verified": {
      "type": "boolean"
    },
    "created_at": {},
    "created_by": {},
    "determinism_hash": {
      "pattern": "\\S",
      "type": "string"
    },
    "display_key": {},
    "edge_regions": {
      "minimum": 0,
      "multipleOf": 1,
      "type": "number"
    },
    "evidence_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
